<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="Giữ lâu một dòng để xoá"
        android:textColor="@color/chu_mo"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvLichSu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_the"
            android:divider="@color/vien"
            android:dividerHeight="1dp"
            android:padding="4dp" />

        <LinearLayout
            android:id="@+id/khoiTrongLichSu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_the"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có lần làm bài nào"
                android:textColor="@color/chu"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingTop="8dp"
                android:text="Hãy sang tab LÀM BÀI để bắt đầu. Kết quả mỗi lần làm sẽ được lưu lại ở đây."
                android:textColor="@color/chu_mo"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnXoaHet"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_phu"
        android:text="XOÁ TẤT CẢ LỊCH SỬ"
        android:textColor="@color/do_sai"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
